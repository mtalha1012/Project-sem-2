<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox styleClass="root-container" stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.talha.quiz.projectsem2.controller.Results">

    <!-- LEFT BRANDING PANEL -->
    <VBox styleClass="left-panel" HBox.hgrow="ALWAYS">
        <padding><Insets bottom="56" left="48" right="48" top="56" /></padding>

        <HBox alignment="CENTER_LEFT">
            <Label styleClass="logo-text" text="IsoGrapher" />
        </HBox>

        <HBox alignment="CENTER_LEFT" styleClass="badge-box">
            <VBox.margin><Insets top="32" /></VBox.margin>
            <Label styleClass="badge-label" text="● Quiz Complete" />
        </HBox>

        <Label styleClass="heading-primary" text="How did you" wrapText="true">
            <VBox.margin><Insets top="24" /></VBox.margin>
        </Label>
        <Label styleClass="heading-accent" text="perform?" wrapText="true" />

        <Label maxWidth="300" styleClass="left-subtitle" text="Review your results below. Keep practicing to strengthen your understanding of graph theory." wrapText="true">
            <VBox.margin><Insets top="12" /></VBox.margin>
        </Label>

        <VBox spacing="14">
            <VBox.margin><Insets top="40" /></VBox.margin>
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label styleClass="feature-dot" text="●" />
                <Label styleClass="feature-text" text="80%+ — Excellent mastery" />
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label styleClass="feature-dot" text="●" />
                <Label styleClass="feature-text" text="50–79% — Good progress" />
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label styleClass="feature-dot" text="●" />
                <Label styleClass="feature-text" text="Below 50% — Keep practicing" />
            </HBox>
        </VBox>

        <Region VBox.vgrow="ALWAYS" />
    </VBox>

    <!-- RIGHT RESULTS PANEL -->
    <VBox alignment="CENTER" maxWidth="460" minWidth="380" styleClass="right-panel">
        <padding><Insets bottom="48" left="40" right="40" top="48" /></padding>

        <Label styleClass="form-title" text="Your Results" />
        <Separator styleClass="divider-line">
            <VBox.margin><Insets bottom="32" top="12" /></VBox.margin>
        </Separator>

        <Label styleClass="field-label" text="FINAL SCORE" />
        <Label fx:id="scoreLabel" styleClass="score-label" text="—">
            <VBox.margin><Insets bottom="4" top="8" /></VBox.margin>
        </Label>
        <Label fx:id="scoreSubtitleLabel" styleClass="score-subtitle" text="">
            <VBox.margin><Insets bottom="24" /></VBox.margin>
        </Label>

        <Label styleClass="field-label" text="FEEDBACK" />
        <Label fx:id="feedbackLabel" styleClass="left-subtitle" text="" wrapText="true" maxWidth="360">
            <VBox.margin><Insets bottom="40" top="8" /></VBox.margin>
        </Label>

        <Button fx:id="tryAgainButton" maxWidth="Infinity" onAction="#handleTryAgain" styleClass="login-btn" text="TRY AGAIN">
            <VBox.margin><Insets bottom="12" /></VBox.margin>
        </Button>

        <HBox alignment="CENTER" spacing="12">
            <VBox.margin><Insets bottom="20" /></VBox.margin>
            <Separator styleClass="divider-line" HBox.hgrow="ALWAYS" />
            <Label styleClass="divider-text" text="OR" />
            <Separator styleClass="divider-line" HBox.hgrow="ALWAYS" />
        </HBox>

        <Button fx:id="dashboardButton" maxWidth="Infinity" onAction="#handleDashboard" styleClass="secondary-btn" text="← Back to Dashboard" />

    </VBox>
</HBox>
